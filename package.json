{
  "name": "groceries-mcp",
  "version": "0.1.0",
  "description": "MCP server that returns weekly grocery deals (Publix, Aldi, Lidl) for use with Claude. Wraps Playwright + lightweight HTTP scrapers, caches per-week.",
  "license": "MIT",
  "author": "Cameron Lewis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "groceries-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http",
    "dev": "tsc --watch",
    "debug:run": "node --import tsx scripts/debug-run.ts",
    "find-publix-store": "node --import tsx scripts/find-publix-store.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/models.test.ts tests/dispatcher.test.ts",
    "prepare": "git config core.hooksPath .githooks",
    "postinstall": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "repo-hygiene": "vitest run tests/repo-hygiene.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "playwright": "^1.50.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
